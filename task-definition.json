{
    "family": "frontendstackec2taskdefinition855D1233",
    "containerDefinitions": [
      {
        "name": "dev-archimedes-frontend-container",
        "cpu": 500,
        "memory": 192,
        "essential": true,
        "portMappings": [
          {
            "containerPort": 80,
            "hostPort": 80,
            "protocol": "tcp"
          }
        ],
        "healthCheck": {
          "command": [
            "CMD-SHELL",
            "curl -f http://localhost:80/ || exit 1"
          ]
        }
      }
    ],
    "networkMode": "awsvpc",
    "requiresCompatibilities": [
      "EC2"
    ]
  }